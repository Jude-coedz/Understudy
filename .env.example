# Server-side AI. Keep GEMINI_API_KEY secret in Cloudflare.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Browser-side Google OAuth + Picker configuration.
# These are public identifiers, not secrets. Restrict the API key to your deployed origin in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# Account + persistent workspace sync.
# These values are public client credentials, but still configure them through Cloudflare runtime variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of SUPABASE_PUBLISHABLE_KEY.
