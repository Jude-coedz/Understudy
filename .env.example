# Server-side AI. Keep GEMINI_API_KEY secret in Cloudflare.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Browser-side Google OAuth + Picker configuration.
# These are public identifiers, not secrets. Restrict the API key to your deployed origin in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
